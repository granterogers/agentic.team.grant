{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "rootDir": ".",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,

    "isolatedModules": true,
    // Imports carry the .ts extension: tsx, vitest and Node 22's own type
    // stripping all resolve it, and nothing here is emitted to JavaScript.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  // The verify probes are hand-run diagnostics that no gate or npm script calls. They index DOM results without the
  // bounds checks noUncheckedIndexedAccess asks for, and typing each one would change nothing they do. They are
  // excluded here, on purpose, and nothing else is excluded.
  "exclude": ["scripts/verify/probe-*.ts"]
}
