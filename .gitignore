# ---------------------------------------------------------------------------
# Secrets — defensive backstop.
#
# The operating rule for this repository is that NO secret-bearing file should
# exist here at all. Bootstrap credentials live in the Claude Code cloud
# environment's Environment variables / API credentials; production runtime
# secrets live in the application's own encrypted store (Settings ->
# Connections & Secrets). This section exists only to catch mistakes.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.secrets
.secrets.*
secrets.json
credentials.json
client_secret*.json
service-account*.json
*service_account*.json
token.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Slack: local-only dev override for per-app credentials. Per the credential
# storage architecture, Slack per-app credentials live in Supabase, encrypted.
# This file is an explicit opt-in override for local debugging only and must
# never become a default expectation.
.slack-dev-override.local

# Gemini Notebook automation auth material — never commit.
master_token.json
cookies.json
*cookies*.json
.notebooklm/
notebooklm_auth/

# Supabase local state / linked project refs that can carry keys
.supabase/
supabase/.temp/
supabase/.branches/

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/
.wrangler/
.open-next/

# Package manager noise (lockfiles ARE committed)
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# ---------------------------------------------------------------------------
# Python (Notebook worker)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.eggs/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.python-version
uv.lock.bak

# ---------------------------------------------------------------------------
# Test / coverage / evidence artifacts
# ---------------------------------------------------------------------------
coverage/
.coverage
.coverage.*
htmlcov/
.nyc_output/
playwright-report/
test-results/
blob-report/
/playwright/.cache/

# Test evidence is committed under docs/test-evidence/, but raw large
# captures (video, traces, full DB dumps) are not.
docs/test-evidence/**/*.webm
docs/test-evidence/**/*.zip
docs/test-evidence/**/*.trace

# ---------------------------------------------------------------------------
# Backups / dumps — must never land in git (see docs/backup-restore guide)
# ---------------------------------------------------------------------------
*.dump
*.sql.gz
backups/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# ---------------------------------------------------------------------------
# Captures
# ---------------------------------------------------------------------------
#
# `.out/` is where `npm run shots` writes its twelve PNGs and where every
# `verify:*` run with SHOT=1 drops more. They are build products: regenerated by
# one command, uploaded to the build page when they are worth Grant seeing, and
# half a megabyte a time otherwise. Same reasoning as the seeded design canvas
# below.
#
# `out/` above does NOT cover this — a leading dot is a different directory
# name, which is why these had been sitting untracked.
.out/

# ---------------------------------------------------------------------------
# Logs / scratch
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
logs/
tmp/
.scratch/

# Generated at deploy time from src/channels/ — never edited here, never committed.
supabase/functions/*/telegram.ts

# Portable exports — generated on demand, never committed
aiteamhq-portable-*.json.gz
aiteamhq-portable-*.sha256

# ---------------------------------------------------------------------------
# Seeded design canvases
# ---------------------------------------------------------------------------
#
# `.design/*.dc.html` and `canvas.json` are the source and are tracked. The
# seeded output beside them is ~2.5 MB of editor payload wrapped around that
# source, regenerated by one command, and republished rather than read — so
# committing it would add a megabyte-scale binary-ish blob per revision for
# nothing. Same reasoning as any other build product.
team-hq-dashboard.html

# Issue #206. The generated source photographs: 14 MB of PNG that exists only
# to be re-tuned. The processed tiles beside it ARE committed, and regenerating
# these costs about $0.07 through npm run textures -- --go.
web/studio/textures/raw/
.vercel

# Generated by `npm run config:site`: which office this deployment belongs to.
# Never committed — a committed default is one office shipped to everybody who
# clones this. See web/studio/backend.js.
web/studio/config.js

# local lists of production identifiers for the staging preflight (never committed)
.staging/

# the visual gallery's full-resolution PNGs (65 MB) ship in the downloadable ZIP, not in git; thumbnails, manifest and index are committed
docs/integration/final-visual-gallery/screenshots/
