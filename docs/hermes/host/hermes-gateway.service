# systemd unit for Hermes itself (a TEMPLATE). It listens on loopback only and runs as an unprivileged user with no access to the
# office's repository, database credentials or any other secret: its only credentials are its own API key, the zero-limit OpenRouter
# key and the office MCP token, all in $HERMES_HOME/.env.
[Unit]
Description=Hermes Agent API server (loopback only) for the office
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Environment=HERMES_HOME=/var/lib/hermes/home
Environment=HOME=/var/lib/hermes/work
WorkingDirectory=/var/lib/hermes/work
ExecStart=/opt/hermes/venv/bin/hermes gateway run
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hermes
# Learning only (RUNBOOK 9a). The approved-skills directory is the BRIDGE'S: Hermes sees it read-only, enforced by the kernel (a read-only mount in this
# unit's private mount namespace), because Hermes's own skill_manage will edit and delete a skill in skills.external_dirs unless the operating system
# refuses (measured on the pinned Hermes; scripts/isolated/engine-learning-host.ts). The leading minus keeps the unit starting while learning is not set up.
# It names the PARENT of the bridge's directory: the bridge replaces its directory by rename, and a mount of the directory itself would go stale.
ReadOnlyPaths=-/var/lib/hermes-skills-export
# Hermes's own configuration is read-only to Hermes as well: its home is writable (it must write sessions and state), and a run that could rewrite a
# profile's config.yaml could turn a toolset on for the NEXT run. Proved with the pinned Hermes serving normally with both files mounted read-only
# (engine-learning-host G1 to G3). Both lines are optional by the same minus; the learning profile's exists only once RUNBOOK 9a step 2 has run.
ReadOnlyPaths=-/var/lib/hermes/home/config.yaml
ReadOnlyPaths=-/var/lib/hermes/home/profiles/hermes-learn/config.yaml
# Without these a process that may create a user namespace could try to remount; with them it has no capability to do so and no namespace to try in.
RestrictNamespaces=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
