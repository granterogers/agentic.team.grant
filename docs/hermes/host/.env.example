# Names only. Copy to the host as two files (one per process), chmod 600, and fill in the values there.
# NEVER commit a value, paste one into chat, or print one: the repository's secret scan fails on a token-shaped value.

# ---- Hermes's own environment ($HERMES_HOME/.env) -------------------------------------------------------------------------------
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1                 # loopback only; Hermes is never reachable from the network
API_SERVER_PORT=8642
API_SERVER_KEY=                           # at least 32 random bytes; the bridge holds the same value as HERMES_API_KEY
OPENROUTER_API_KEY=                       # the Hermes-ONLY key with a credit limit of 0 (never the office's key). See RUNBOOK step 3.
OFFICE_ENGINE_MCP_TOKEN=                  # the MCP token minted with the bridge (mcp_<48 hex>); read scope, engine kind

# ---- The bridge's environment (the service unit's EnvironmentFile) ---------------------------------------------------------------
ENGINE_GATEWAY_URL=                       # https://<project-ref>.supabase.co/functions/v1/engine
ENGINE_BRIDGE_TOKEN=                      # the bridge token minted with the credentials (ebt_<64 hex>)
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=                           # the same value as API_SERVER_KEY
ALLOW_PRODUCTION_CHECKS=1                 # set deliberately by the person who runs the host: the bridge writes to the office's database
ALLOW_PRODUCTION_WRITES=1                 # through the gateway, so it needs the same two switches a deploy needs

# ---- Learning only (RUNBOOK 9a; leave out while learning is off) -----------------------------------------------------------------
# The bridge's environment:
#   HERMES_LEARN_DIR=/var/lib/hermes/learn                         where the learning profile writes a draft (skills.create_dir); read, proposed and deleted by the bridge
#   HERMES_SKILLS_EXPORT_DIR=/var/lib/hermes-skills-export/office  the office's approved skills, written by the bridge; its PARENT is read-only to Hermes's unit
# The learning profile's own environment ($HERMES_HOME/profiles/hermes-learn/.env) is written by `npm run hermes:learn-profile`, which COPIES
# API_SERVER_KEY, OFFICE_ENGINE_MCP_TOKEN and OPENROUTER_API_KEY from the default profile's file (mode 0600). With two profiles Hermes reads a
# secret from the profile's own .env, not from the process environment. Nothing is typed and nothing is printed.

# The bridge REFUSES to start if its environment holds any of: SUPABASE_*, DATABASE_URL, POSTGRES*, or HERMES_YOLO_MODE set on.
