{
  "name": "ai-team-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:secrets": "python3 scripts/secret-scan.py",
    "verify": "npm run lint && npm run typecheck && npm run check:migrations && npm run test && npm run check:secrets",
    "migrate": "tsx scripts/migrate.ts",
    "verify:ledger": "tsx scripts/verify/ledger.ts",
    "verify:jobs": "tsx scripts/verify/jobs.ts",
    "verify:transitions": "tsx scripts/verify/transitions.ts",
    "verify:db": "npm run verify:transitions && npm run verify:ledger && npm run verify:jobs && npm run verify:credentials && npm run verify:router",
    "backup:manifest": "tsx scripts/backup/manifest.ts",
    "backup:connection": "tsx scripts/backup/print-connection.ts",
    "verify:restore": "tsx scripts/backup/verify-restore.ts",
    "verify:credentials": "tsx scripts/verify/credentials.ts",
    "bootstrap:backup-credentials": "tsx scripts/bootstrap/store-backup-credentials.ts",
    "backup:credentials": "tsx scripts/backup/load-credentials.ts",
    "bootstrap:db-password": "tsx scripts/bootstrap/reset-db-password.ts",
    "backup:roles": "tsx scripts/backup/emit-roles.ts",
    "providers:discover": "tsx scripts/providers/discover.ts",
    "verify:router": "tsx scripts/verify/router.ts",
    "slack:rotate": "tsx scripts/slack/rotate.ts",
    "telegram:configure": "tsx scripts/telegram/configure.ts",
    "deploy:telegram": "tsx scripts/deploy/edge-function.ts",
    "audit:credentials": "tsx scripts/audit/credentials.ts",
    "verify:all": "npm run verify && npm run audit:credentials && npm run verify:db",
    "deploy:voice": "tsx scripts/deploy/voice.ts",
    "deploy:page": "tsx scripts/deploy/vercel.ts",
    "poc:gate-5": "tsx scripts/poc/gate-5.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
